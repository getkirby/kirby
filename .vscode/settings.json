{
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.path.oxfmt": "panel/node_modules/.bin/oxfmt",
  "eslint.workingDirectories": ["./panel"],
  "phpunit.command": "composer test -- ${phpunitargs}",
  "phpunit.environment": {
    "COMPOSER_PROCESS_TIMEOUT": "0"
  }
}
