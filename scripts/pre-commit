#!/usr/bin/env bash

##########
## Pre-commit hook script for Git
## Runs static analysis on all staged files before they are committed
##
## ------
## Usage:
## Create an executable file `.git/hooks/pre-commit` with the following contents:
##
##   #!/bin/sh
##   exec scripts/pre-commit
##
## You may need to modify the `$PATH` variable so Git can find your tools;
## if the script above triggers an error, use a line like this above `exec`:
##
##   export PATH=$HOME/.composer/vendor/bin:$PATH
##########

# exit on the first error
set -e

# enable extended globbing
shopt -s extglob

php=()
psalm=()
panel=()
composer=false

# collect all staged files (deleted files can't be checked)
while read -r file; do
    case "$file" in
        bootstrap.php | router.php | @(config|src|tests|views)/**.php)
            php+=("$file")

            if [[ "$file" != tests/** ]]; then
                psalm+=("$file")
            fi
        ;;

        # built bundles
        panel/dist/*)
        ;;

        panel/*.@(js|ts|vue))
            panel+=("${file#panel/}")
        ;;

        composer.json | composer.lock)
            composer=true
        ;;
    esac
done < <(git diff --cached --name-only --diff-filter=d)

# check each group with one run per tool
if [[ ${#php[@]} -gt 0 ]]; then
    echo "### PHP-CS-Fixer"
    # multiple paths need an explicit config
    composer run fix:style -- --config=.php-cs-fixer.dist.php --dry-run --diff "${php[@]}"
    composer run fix:types -- --dry-run --diff "${php[@]}"
    echo
fi

if [[ ${#psalm[@]} -gt 0 ]]; then
    echo "### Psalm"
    composer run analyze:psalm -- "${psalm[@]}"
    echo
fi

if [[ ${#panel[@]} -gt 0 ]]; then
    cd panel

    echo "### ESLint"
    npm exec -- eslint --no-fix "${panel[@]}"
    echo

    echo "### Oxfmt"
    npm exec -- oxfmt --check "${panel[@]}"
    echo

    cd ..
fi

if [[ $composer == true ]]; then
    echo "### composer validate"
    composer run analyze:composer
    echo
fi
