{
	"name": "kirby",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"ci": "npm run test && npm run lint && npm run format",
		"build:docs": "node scripts/docs.js",
		"dev": "vite --host",
		"format": "prettier --check \"src/**/*.{js,ts,vue}\"",
		"format:fix": "npm run format -- --write",
		"lint": "eslint \"src/**/*.{js,ts,vue}\"",
		"lint:fix": "npm run lint -- --fix",
		"test": "npm run test:unit && npm run test:types",
		"test:unit": "vitest run --no-isolate",
		"test:coverage": "npm run test:unit -- --coverage",
		"test:types": "vue-tsc --noEmit"
	},
	"dependencies": {
		"autosize": "^6.0.1",
		"dayjs": "^1.11.23",
		"mitt": "^3.0.1",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.1",
		"prosemirror-inputrules": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.12",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.42.6",
		"sortablejs": "^1.15.7",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/autosize": "^4.0.3",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/eslint-plugin": "1.6.27",
		"@vue/compiler-sfc": "^3.5.43",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"eslint-plugin-vuejs-accessibility": "^2.6.2",
		"glob": "^13.0.6",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.5",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vite-plugin-static-copy": "^4.1.1",
		"vitest": "^5.0.3",
		"vue-docgen-api": "^4.79.2",
		"vue-tsc": "^3.3.12"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild@0.28.2": true
	}
}
